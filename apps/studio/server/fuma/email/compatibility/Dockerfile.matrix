ARG BUN_IMAGE=oven/bun:1.3.14@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4
ARG NODE_IMAGE=node:24.12.0-bookworm@sha256:929c026d5a4e4a59685b3c1dbc1a8c3eb090aa95373d3a4fd668daa2493c8331
FROM ${BUN_IMAGE} AS bun_runtime
FROM ${NODE_IMAGE}
COPY --from=bun_runtime /usr/local/bin/bun /usr/local/bin/bun
RUN ln -s /usr/local/bin/bun /usr/local/bin/bunx
COPY matrix-entrypoint.sh /usr/local/bin/fuma-email-matrix-entrypoint
RUN chmod 0555 /usr/local/bin/fuma-email-matrix-entrypoint
ENTRYPOINT ["/usr/local/bin/fuma-email-matrix-entrypoint"]
