{
  "name": "@fuma/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0 <1.4.0",
    "node": ">=20.18.1"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3002",
    "build": "bun run tokens:check && bun run editorial:generate && next build && bun run budgets:check",
    "editorial:generate": "bun run scripts/generate-editorial-search.ts",
    "editorial:check": "bun run scripts/generate-editorial-search.ts --check",
    "budgets:check": "bun run scripts/check-public-web-budgets.ts",
    "start": "mkdir -p .next/standalone/apps/web/.next/static && cp -R .next/static/. .next/standalone/apps/web/.next/static/ && HOSTNAME=0.0.0.0 PORT=3002 node .next/standalone/apps/web/server.js",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test tests",
    "test:e2e": "playwright test --config playwright.config.ts",
    "tokens:sync": "bun run scripts/sync-design-token-css.ts",
    "tokens:check": "bun run scripts/sync-design-token-css.ts --check"
  },
  "dependencies": {
    "@fuma/brand": "workspace:*",
    "@fuma/design-tokens": "workspace:*",
    "@fuma/public-contracts": "workspace:*",
    "@mdx-js/react": "3.1.1",
    "@radix-ui/react-slot": "1.3.3",
    "@sinclair/typebox": "0.34.49",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.26.0",
    "next": "16.2.9",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@mdx-js/loader": "3.1.1",
    "@next/mdx": "16.2.9",
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.13",
    "@types/node": "24.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "postcss": "8.5.16",
    "shadcn": "4.14.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3"
  }
}
