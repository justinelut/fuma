# Public Web runtime configuration. Values are injected by the deployment owner.
FUMA_PUBLIC_PROJECTION_INTERNAL_ORIGIN=http://studio-internal.service:3001
FUMA_PUBLIC_PROJECTION_SERVICE_TOKEN=
FUMA_PUBLIC_PROJECTION_TIMEOUT_MS=3000
FUMA_DEPLOYMENT_ROOT_DOMAIN=trimly.co.ke
# Browser acceptance remains separately bounded to https://3002.blyss.co.ke in code and Playwright.
FUMA_CONTENT_PREVIEW_TOKEN=
FUMA_WEB_METRICS_TOKEN=
FUMA_WEB_REVISION=
# Server-only fresh status projection. URLs must be credential/query/hash free HTTPS endpoints.
FUMA_STATUS_SUMMARY_URL=
FUMA_STATUS_SUMMARY_TOKEN=
FUMA_PUBLIC_STATUS_PAGE_URL=
# The exact product resume origin is derived from FUMA_DEPLOYMENT_ROOT_DOMAIN and remains fail-closed.
FUMA_PUBLIC_PREVIEW_HOST=
