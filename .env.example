# Local development environment template.
#
# Instatic requires PostgreSQL for local development and tests. Ensure the
# dedicated local database is running before starting the app, then copy this
# file to .env or export the variables in your shell.

PORT=3001

# Comma-separated CIDRs for reverse proxies whose X-Forwarded-For header may
# be trusted. Leave empty for direct/local development.
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# ─── Database ────────────────────────────────────────────────────────────────
# Canonical local PostgreSQL connection. Use a separate database or isolated
# schemas for tests; never point development or test commands at production.
DATABASE_URL=postgres://instatic:instatic@127.0.0.1:5433/instatic

# ─── Filesystem paths ────────────────────────────────────────────────────────
UPLOADS_DIR=./uploads
STATIC_DIR=./apps/studio/dist

# ─── AI credential encryption ───────────────────────────────────────────────
# Local development may create a temporary key, but production deployments
# must set a stable INSTATIC_SECRET_KEY. Generate one with:
#
#   openssl rand -base64 32
#
# INSTATIC_SECRET_KEY=
