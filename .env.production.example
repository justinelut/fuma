# Production environment template for the PostgreSQL stack.
#
# Copy to .env, replace every placeholder secret, and run compose.prod.yml:
#   cp .env.production.example .env
#   INSTATIC_IMAGE=ghcr.io/corebunch/instatic:latest docker compose -f compose.prod.yml up -d

# ─── Image ───────────────────────────────────────────────────────────────────
INSTATIC_IMAGE=ghcr.io/corebunch/instatic:latest

# ─── Reversible server secret encryption ───────────────────────────────────
# Required before saving AI/provider credentials, plugin secret settings, or
# enabling TOTP MFA. Generate with: openssl rand -base64 32
INSTATIC_SECRET_KEY=replace-with-output-of-openssl-rand

# Hosted Fuma only: independent site-member token HMAC secret. It must be at
# least 32 characters and must not equal another application secret.
FUMA_MEMBER_AUTH_SECRET=replace-with-a-different-32-byte-random-secret

# ─── Networking ──────────────────────────────────────────────────────────────
HOST_PORT=3001

# Trust only the actual reverse proxy source CIDRs. Leave empty for direct
# exposure. This setting affects client-IP attribution, not CSRF.
TRUSTED_PROXY_CIDRS=

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# compose.prod.yml embeds these values in the app's DATABASE_URL. Replace the
# password before first start; generate one with: openssl rand -hex 24
POSTGRES_DB=instatic
POSTGRES_USER=instatic
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password

# For external/managed PostgreSQL deployments, set DATABASE_URL in the platform
# environment instead of using the bundled service values above.
# DATABASE_URL=postgresql://user:password@database.internal:5432/instatic

# ─── TLS — used with compose.tls.yml ────────────────────────────────────────
DOMAIN=cms.example.com
LETSENCRYPT_EMAIL=

# Comma-separated public origins trusted by CSRF protection. compose.tls.yml
# defaults this from DOMAIN; set explicitly for custom/multiple origins.
PUBLIC_ORIGIN=
