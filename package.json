{
  "name": "fuma",
  "private": true,
  "version": "0.0.11",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0 <1.4.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --cwd=apps/studio run dev",
    "dev:agent": "bun --cwd=apps/studio run dev:agent",
    "dev:server": "bun --cwd=apps/studio run dev:server",
    "dev:vite": "bun --cwd=apps/studio run dev:vite",
    "dev:web": "bun --cwd=apps/web run dev",
    "dev:site-runtime": "bun tooling/site-runtime/prepareAppDependencies.ts && apps/web/node_modules/.bin/next dev apps/site-runtime --hostname 0.0.0.0 --port 3003",
    "dev:control": "bun --cwd=apps/control-surfaces run dev",
    "build:control": "bun --cwd=apps/control-surfaces run build",
    "build:site-runtime": "bun tooling/site-runtime/prepareAppDependencies.ts && apps/web/node_modules/.bin/next build apps/site-runtime && bun tooling/site-runtime/prepareStandaloneAssets.ts",
    "typecheck:site-runtime": "bun tooling/site-runtime/prepareAppDependencies.ts && apps/web/node_modules/.bin/next typegen apps/site-runtime && node_modules/.bin/tsc -p apps/site-runtime/tsconfig.json --noEmit",
    "typecheck:control": "bun --cwd=apps/control-surfaces run typecheck",
    "test:control": "bun --cwd=apps/control-surfaces run test",
    "typecheck:governance": "bun --cwd=packages/fuma-governance-launch run typecheck",
    "test:governance": "bun --cwd=packages/fuma-governance-launch run test",
    "e2e:dev": "bun --cwd=apps/studio run e2e:dev",
    "db:drop": "bun --cwd=apps/studio run db:drop",
    "fuma:migrate": "bun --cwd=apps/studio run fuma:migrate",
    "fuma:transition": "bun --cwd=apps/studio run fuma:transition",
    "start": "bun --cwd=apps/studio run start",
    "start:web": "bun --cwd=apps/web run start",
    "start:site-runtime": "HOSTNAME=0.0.0.0 PORT=3003 node apps/site-runtime/.next/standalone/apps/site-runtime/server.js",
    "typecheck:web": "bun --cwd=apps/web run typecheck",
    "build:studio": "bun --cwd=apps/studio run build",
    "build:web": "bun --cwd=apps/web run build",
    "fuma:web": "bun --cwd=apps/studio run fuma:web",
    "fuma:worker": "bun --cwd=apps/studio run fuma:worker",
    "fuma:scheduler": "bun --cwd=apps/studio run fuma:scheduler",
    "docker:up": "bun --cwd=apps/studio run docker:up",
    "release:bundle": "bun --cwd=apps/studio run release:bundle",
    "build": "bun --cwd=packages/brand run typecheck && bun --cwd=packages/design-tokens run typecheck && bun --cwd=packages/public-contracts run typecheck && bun run typecheck:governance && bun run build:studio && bun run build:web && bun run build:site-runtime && bun run build:control",
    "lint": "eslint apps packages tooling --cache --cache-location .tmp-lint/eslint-cache",
    "preview": "bun --cwd=apps/studio run preview",
    "test": "bun test && bun run test:web && bun run test:control && bun run test:governance",
    "test:web": "bun --cwd=apps/web run test",
    "test:web:e2e": "bun --cwd=apps/web run test:e2e",
    "tokens:web:sync": "bun --cwd=apps/web run tokens:sync",
    "tokens:web:check": "bun --cwd=apps/web run tokens:check",
    "test:e2e": "bun --cwd=apps/studio run test:e2e",
    "test:e2e:install": "bun --cwd=apps/studio run test:e2e:install",
    "test:e2e:ui": "bun --cwd=apps/studio run test:e2e:ui",
    "test:watch": "bun test --watch",
    "test:bundle": "bun run build && bun test apps/studio/src/__tests__/architecture/bundle-size-budgets.test.ts",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir=.coverage && bun --cwd=apps/studio run scripts/lcov-to-istanbul.ts ../../.coverage/lcov.info ../../.coverage/coverage-final.json",
    "fallow:health": "bun run test:coverage && npx fallow health --coverage .coverage/coverage-final.json",
    "icons:sync": "bun --cwd=apps/studio run icons:sync",
    "icons:check": "bun --cwd=apps/studio run icons:check",
    "bootstrap:sync": "bun --cwd=apps/studio run bootstrap:sync",
    "bootstrap:check": "bun --cwd=apps/studio run bootstrap:check",
    "instatic-plugin": "bun --cwd=apps/studio run instatic-plugin",
    "bench": "bun --cwd=apps/studio run bench",
    "bench:bundle": "bun --cwd=apps/studio run bench:bundle",
    "bench:publisher": "bun --cwd=apps/studio run bench:publisher",
    "bench:publish": "bun --cwd=apps/studio run bench:publish",
    "bench:editor-store": "bun --cwd=apps/studio run bench:editor-store",
    "bench:http": "bun --cwd=apps/studio run bench:http",
    "bench:db": "bun --cwd=apps/studio run bench:db",
    "bench:plugin": "bun --cwd=apps/studio run bench:plugin",
    "bench:footprint": "bun --cwd=apps/studio run bench:footprint",
    "bench:health": "bun --cwd=apps/studio run bench:health",
    "bench:browser": "bun --cwd=apps/studio run bench:browser",
    "bench:browser:install": "bun --cwd=apps/studio run bench:browser:install",
    "doctor": "bun --cwd=apps/studio run doctor"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sinclair/typebox": "^0.34.49",
    "eslint": "^10.3.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.1"
  }
}
