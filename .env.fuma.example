# Fuma hosted production configuration template.
#
# Copy to an ignored environment file and fill every blank value before boot.
# readFumaConfig fails closed when any required production class is incomplete.
# This template intentionally contains no credentials, owner identity, private key material,
# or realistic credential-shaped placeholders.

# Both production signals are explicit. NODE_ENV=production without FUMA_ENV=production is rejected.
NODE_ENV=production
FUMA_ENV=production

# One deployment root; exact public, www, auth, app, admin, status, preview, and tenant hosts are derived.
FUMA_DEPLOYMENT_ROOT_DOMAIN=trimly.co.ke

# Runtime role. FUMA-005 owns role-specific process composition.
FUMA_ROLE=web

# Shared hosted PostgreSQL and Redis. No local/file database is accepted.
DATABASE_URL=
FUMA_REDIS_URL=

# Private Studio → public Web projection boundary. The host/origin are cluster-only;
# the shared token is injected into both services and never exposed to browsers.
FUMA_REDIS_NAMESPACE=
FUMA_PUBLIC_PROJECTION_INTERNAL_HOST=
FUMA_PUBLIC_PROJECTION_INTERNAL_ORIGIN=
FUMA_PUBLIC_PROJECTION_SERVICE_TOKEN=
FUMA_PUBLIC_PROJECTION_TIMEOUT_MS=3000

# FUMA-077 server-only GitHub App authority. Installation tokens are minted per
# request, held only in memory, and never sent to the Studio browser or persisted.
FUMA_GITHUB_APP_ID=
FUMA_GITHUB_APP_PRIVATE_KEY_PEM=
FUMA_GITHUB_USER_AGENT=fuma-next-source-importer/1

# Shared MinIO object storage. The endpoint is an HTTP(S) origin, not a credential-bearing URL.
FUMA_MINIO_ENDPOINT=
FUMA_MINIO_ACCESS_KEY_ID=
FUMA_MINIO_SECRET_ACCESS_KEY=
FUMA_MINIO_BUCKET=

# Independent HMAC authority for FUMA object capability URLs. Never reuse MinIO credentials.
FUMA_OBJECT_ACCESS_SIGNING_SECRET=

# Independent base64url-encoded 256-bit AES-GCM key for hosted AI BYOK metadata.
FUMA_AI_BYOK_METADATA_KEY=

# Independent base64url-encoded 256-bit AES-GCM key for mediated expert inquiries.
FUMA_EXPERT_INQUIRY_KEY=
FUMA_EXPERT_INQUIRY_KEY_ID=expert-inquiry-primary

# Optional platform-owned OCI Email Delivery. Leave every value absent to keep
# email disabled. If any value is set, all eight are required.
FUMA_OCI_EMAIL_REGION=
FUMA_OCI_EMAIL_TENANCY_ID=
FUMA_OCI_EMAIL_USER_ID=
FUMA_OCI_EMAIL_FINGERPRINT=
FUMA_OCI_EMAIL_PRIVATE_KEY_PEM=
FUMA_OCI_EMAIL_COMPARTMENT_ID=
FUMA_OCI_EMAIL_APPROVED_SENDER=
FUMA_OCI_EVENT_VERIFICATION_SECRET=

# Signed one-click unsubscribe authority.
FUMA_PUBLICATION_UNSUBSCRIBE_SIGNING_SECRET=

# Platform Paystack trust boundary. Tenant sites supply their own merchant
# credentials through the encrypted customer-merchant settings boundary.
FUMA_PAYSTACK_PROVIDER_URL=https://api.paystack.co
FUMA_PAYSTACK_PLATFORM_PUBLIC_KEY=
FUMA_PAYSTACK_PLATFORM_SECRET_KEY=

# Fuma-owned Cloudflare account and zone.
FUMA_CLOUDFLARE_ACCOUNT_ID=
FUMA_CLOUDFLARE_ZONE_ID=
FUMA_CLOUDFLARE_API_TOKEN=

# Kenya launch metadata. Timestamps remain UTC; this zone controls display.
FUMA_LOCALE=en-KE
FUMA_CURRENCY=KES
FUMA_TIME_ZONE=Africa/Nairobi

# Versioned USD-micro → KES-minor cost conversion authority. Set a reviewed version
# plus a positive integer ratio; conversion rounds provider cost upward, never down.
FUMA_KES_FX_VERSION=
FUMA_KES_MINOR_NUMERATOR=
FUMA_USD_MICROS_DENOMINATOR=

# Protected platform owner identity. FUMA-014 owns account bootstrap behavior.
FUMA_PROTECTED_OWNER_EMAIL=

# Staff cookie policy for app.trimly.co.ke. Host-only scope is enforced by omitting Domain;
# FUMA_COOKIE_DOMAIN and FUMA_COOKIE_HOST_ONLY are therefore rejected if present.
FUMA_COOKIE_SECURE=true
FUMA_COOKIE_HTTP_ONLY=true
FUMA_COOKIE_SAME_SITE=lax

# FUMA-SITE-003 private exact-host tenant runtime (use independent random values)
FUMA_SITE_RUNTIME_PRIVATE_HOST=fuma-site-runtime.internal
FUMA_SITE_RUNTIME_PRIVATE_ORIGIN=https://fuma-site-runtime.internal
FUMA_SITE_RUNTIME_SERVICE_TOKEN=replace-with-independent-random-service-token-at-least-32-bytes
FUMA_SITE_RUNTIME_ROUTING_TOKEN=replace-with-independent-random-edge-routing-token-at-least-32-bytes
FUMA_SITE_RUNTIME_DEPLOYMENT_VERSION=1.0.0
FUMA_SITE_RUNTIME_SUPPORTED_DEPLOYMENTS=1.0.0
