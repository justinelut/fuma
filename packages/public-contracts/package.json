{
  "name": "@fuma/public-contracts",
  "private": true,
  "version": "0.0.0",
  "description": "Strict TypeBox contracts for Fuma public boundaries.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "src",
    "README.md"
  ],
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "bun run typecheck",
    "test": "bun run tests/hostile-validation.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.49"
  }
}
